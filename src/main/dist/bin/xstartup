#!/bin/sh
unset XDG_RUNTIME_DIR
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export DISPLAY=:5
export GDK_BACKEND=x11
unset WAYLAND_DISPLAY

# Detect the directory where this startup script is located
SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"

# Isolate the browser profile home dynamically
VNC_HOME="/tmp/vnc_sandbox_user_$USER"
mkdir -p "$VNC_HOME"
export HOME="$VNC_HOME"

autocutsel -s CLIPBOARD -fork
autocutsel -s PRIMARY -fork
openbox &

# Execute the kiosk script located in the same directory within the DBus session
exec dbus-run-session "$SCRIPT_DIR/quick-question.sh" "http://www.google.com"