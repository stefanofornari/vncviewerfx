<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ste.vnc.viewer.VNCPane?>


<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ste.vnc.viewer.demo.VNCViewerFXController">
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Connect..." onAction="#onConnect" accelerator="Ctrl+O"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#onExit" accelerator="Ctrl+Q"/>
            </Menu>
            <Menu text="View">
                <MenuItem text="Full Screen" onAction="#onToggleFullScreen" accelerator="F11"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#onAbout"/>
            </Menu>
        </MenuBar>
    </top>
    <center>
        <HBox fillHeight="true">
            <TextArea fx:id="infoText"
                      wrapText="true" editable="true" prefWidth="200.0"
                      text="This area demonstrates clipboard integration between the local system and the remote VNC desktop.&#10;&#10;You can cut or copy text here and paste it into applications on the remote desktop using the standard paste shortcut (usually Ctrl+V).&#10;&#10;Likewise, text copied on the remote desktop is automatically transferred to the local clipboard and can be pasted here or into other local applications."
            />
            <ScrollPane fx:id="canvasScrollPane" HBox.hgrow="ALWAYS"
                        style="-fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                        pannable="false"
                        maxWidth="Infinity" maxHeight="Infinity"
                        fitToWidth="true" fitToHeight="true">
                <content>
                    <!--VNCPane></VNCPane-->
                </content>
            </ScrollPane>
            <!--RectangleTracePane fx:id="rectangleTracePane" minWidth="400.0" /-->
        </HBox>
    </center>
</BorderPane>
